# KisanSetu frontend — environment template
# Copy this file to `.env.local` and fill in real values. NEVER commit `.env.local`.

# When true, the app uses in-browser mock data instead of the backend service below.
NEXT_PUBLIC_USE_MOCK_API=true

# Base URL of the backend API services (used when NEXT_PUBLIC_USE_MOCK_API=false).
# This is what the Aggregation / Quality / Settlement agents will expose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Pexels API key — powers produce photos on lot cards (Grade-quality photos).
# Read server-side only, by /api/crop-photo; never shipped to the client bundle.
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=